<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>GEMINI_API_KEY</key>
    <string>YOUR_API_KEY_HERE</string>

    <!-- Optional. Enables the Search button, which is hidden without it.
         Free key at https://tavily.com — 1,000 searches/month.

         Search never runs automatically: you read the cheap answer first,
         then tap Search if it's worth the credits. Each tap spends one
         credit per generated query (Settings > Search). -->
    <key>TAVILY_API_KEY</key>
    <string>YOUR_TAVILY_KEY_HERE</string>
</dict>
</plist>
