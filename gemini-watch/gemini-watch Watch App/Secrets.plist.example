<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>GEMINI_API_KEY</key>
    <string>YOUR_API_KEY_HERE</string>

    <!-- Optional. Enables Web Search without moving the Gemini project onto
         a billing-enabled (paid) tier. Get a free key at https://tavily.com
         — 1,000 searches/month, no card required. Omit this key and the app
         falls back to Gemini's built-in google_search grounding, which needs
         billing enabled on your Google Cloud project. -->
    <key>TAVILY_API_KEY</key>
    <string>YOUR_TAVILY_KEY_HERE</string>
</dict>
</plist>
