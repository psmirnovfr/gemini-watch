<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>GEMINI_API_KEY</key>
    <string>YOUR_API_KEY_HERE</string>

    <!-- Everything below is optional.

         Web Search works with no extra keys at all: it defaults to the
         keyless DuckDuckGo backend, which needs no account, no API key and
         no payment details. That backend parses HTML, so it can break when
         DuckDuckGo changes its markup, and it may rate-limit.

         For a more reliable backend, add a Tavily key (https://tavily.com)
         and it will be preferred automatically. -->

    <!-- <key>TAVILY_API_KEY</key>
         <string>YOUR_TAVILY_KEY_HERE</string> -->

    <!-- Force a specific backend. Omit to auto-select (Tavily if its key is
         present, otherwise DuckDuckGo).
           duckduckgo  keyless, no signup
           tavily      needs TAVILY_API_KEY
           gemini      Gemini's built-in google_search grounding;
                       requires billing enabled on your Google Cloud project -->

    <!-- <key>SEARCH_BACKEND</key>
         <string>duckduckgo</string> -->
</dict>
</plist>
